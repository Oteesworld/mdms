{
  "name": "amplified-iot-mdms-server",
  "version": "0.1.0",
  "private": true,
  "description": "Amplified IoT meter data service: ChirpStack v4 integration, payload decoding, live meter dashboard.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "LOG_LEVEL=silent node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "cs": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --import tsx src/cli.ts"
  },
  "dependencies": {
    "@chirpstack/chirpstack-api": "^4.20.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "google-protobuf": "^3.21.4",
    "mqtt": "^5.16.1",
    "undici": "^8.12.4"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
