# --- this service ---
PORT=8080
# Public HTTPS URL where ChirpStack can reach this service (used by `npm run cs -- setup`
# to register the HTTP integration that pushes uplinks here).
PUBLIC_URL=https://mdms.example.co.bw
# Shared secret ChirpStack sends as X-Integration-Token. Generate with: openssl rand -hex 24
INTEGRATION_TOKEN=
DB_PATH=data/mdms.sqlite

# --- ChirpStack v4 ---
CHIRPSTACK_URL=https://teemane.leeroysystems.co.bw
# ChirpStack web UI > API keys (tenant or network-server key). Never commit this.
CHIRPSTACK_API_TOKEN=
# Optional when the key can see exactly one tenant.
CHIRPSTACK_TENANT_ID=
CHIRPSTACK_APPLICATION_NAME=Amplified IoT Water Meters
CHIRPSTACK_DEVICE_PROFILE_NAME=Amplified IoT Water Meter (EU868 OTAA)
CHIRPSTACK_REGION_CONFIG_ID=eu868

# --- meter radio settings (confirm against the meter datasheet) ---
METER_MAC_VERSION=1.0.3
METER_REG_PARAMS_REVISION=A
METER_UPLINK_INTERVAL_S=86400
METER_OFFLINE_AFTER_S=93600
METER_LOW_BATTERY_PCT=20

# --- optional: MQTT instead of / as well as the HTTP integration ---
# MQTT_URL=mqtt://teemane.leeroysystems.co.bw:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC=application/+/device/+/event/+
